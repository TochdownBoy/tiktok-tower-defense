PORT=3000
# TikTok username of the streamer whose live you want to listen to.
# The account MUST be currently live, otherwise the room ID cannot be resolved.
TIKTOK_USERNAME=

# REQUIRED: free API key from https://tik.tools (no credit card). Needed because
# the old Euler Stream signing endpoint is paywalled on the Business plan.
TIKTOOL_API_KEY=

# Optional: custom sign-server URL (defaults to https://api.tik.tools)
TIKTOOL_SIGN_SERVER_URL=

# Optional: pre-resolved ttwid session cookie and/or room ID to skip the initial
# TikTok page fetch (helps when anonymous lookups are blocked).
TIKTOOL_SESSION_ID=
TIKTOOL_ROOM_ID=
